# HomeVault database setup is for controlled development and preview data only.
# Do not commit real secrets.

# PostgreSQL connection string used by Prisma commands and runtime access.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/homevault?schema=public"

# Fail-closed switch for the temporary unauthenticated database mode.
# DATABASE_URL alone never enables app reads or writes.
# Enable only for controlled, non-sensitive preview data. Remove this setting
# when production authentication and household authorisation are introduced.
HOMEVAULT_PREVIEW_DATABASE_ACCESS="disabled"

# Production authentication is not implemented yet.
# Authentication environment variables will be added only with the approved provider.
